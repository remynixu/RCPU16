{
    "version": "2.0.0",
    "tasks": [
        /* DEBUG */
        {
            "label": "DEBUG BUILD DIR",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (Test-Path 'build_debug') { Remove-Item -Recurse -Force 'build_debug'}"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "DEBUG CMAKE CONFIG",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}\\.",
                "-B", "${workspaceFolder}\\build_debug",
                "-G", "MinGW Makefiles",
                "-DCMAKE_MAKE_PROGRAM=C:\\raylib\\w64devkit\\bin\\make.exe",
                "-DCMAKE_C_COMPILER=C:\\raylib\\w64devkit\\bin\\gcc.exe",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "dependsOn": [
                "DEBUG BUILD DIR"
            ]
        },
        {
            "label": "DEBUG CMAKE BUILD",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build_debug", "-j2"
            ],
            "dependsOn": [
                "DEBUG CMAKE CONFIG"
            ]
        },

